{
  "compilerOptions": {
    "target": "ES2020",             // Or ES2022
    "module": "CommonJS",           // CDK expects CommonJS
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
