{
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "noImplicitAny": true,
    "outDir": "dist",
    "declaration": false,
    "paths": {
      "@/*": ["./src/*"]
    },
    "sourceMap": false,
    "target": "ES2020",
    "typeRoots": ["./src/types", "./node_modules/@types"],
    "rootDir": "src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist", "build"]
}
