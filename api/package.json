{
  "type": "module",
  "name": "api",
  "version": "1.0.0",
  "description": "Rest API for linkio",
  "author": "badatt <dev.badatt@gmail.com>",
  "private": true,
  "main": "app.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "npm run build && tsc -p test/tsconfig.json && FASTIFY_AUTOLOAD_TYPESCRIPT=1 node --test --experimental-test-coverage --loader ts-node/esm test/**/*.ts",
    "start": "npm run build && fastify start -p 4001 -l info dist/app.js",
    "build": "tsc --build --clean && tsc",
    "watch:ts": "tsc -w",
    "dev": "npm run build && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:watch:ts\" \"npm:dev:start\"",
    "dev:start": "dotenv -e .sandbox.env -- fastify start -p 4001 --ignore-watch=.ts$ -w -l info -P dist/app.js"
  },
  "keywords": [],
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.782.0",
    "@fastify/autoload": "^6.0.0",
    "@fastify/aws-lambda": "^5.1.4",
    "@fastify/cors": "^11.0.1",
    "@fastify/sensible": "^6.0.0",
    "fastify": "^5.0.0",
    "fastify-cli": "^7.4.0",
    "fastify-plugin": "^5.0.0",
    "nanoid": "^5.1.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.148",
    "@types/node": "^22.14.0",
    "c8": "^10.1.2",
    "concurrently": "^9.0.0",
    "dotenv-cli": "^8.0.0",
    "fastify-tsconfig": "^3.0.0",
    "ts-node": "^10.4.0",
    "typescript": "~5.8.2"
  }
}
